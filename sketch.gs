function setup() {
  createCanvas(900, 400);
}

function draw() {
  background("skyblue");

  strokeWeight(0)
   fill("green")
  rect(0, 200, 800, 400) 

   fill("yellow")
  stroke("orange")
  strokeWeight(3)
  circle(720, 35, 60) 

  textSize(107)
  text("🌳",400,200)

  textSize(70)
  text("🏃‍♂️",500, 250) 

  textSize(40)
  text("💨",550,240)
}
